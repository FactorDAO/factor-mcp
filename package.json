{
  "name": "@factordao/mcp-server",
  "version": "1.7.7",
  "description": "MCP server for Factor Protocol vault management",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "factor-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/registration.test.ts tests/adapters.test.ts tests/schemas.test.ts tests/lending.test.ts",
    "test:integration": "vitest run tests/integration.test.ts",
    "test:e2e": "vitest run tests/e2e-mcp.test.ts"
  },
  "keywords": [
    "mcp",
    "factor",
    "defi",
    "vault",
    "ai"
  ],
  "author": "Factor DAO",
  "license": "MIT",
  "dependencies": {
    "@factordao/sdk": "pro-beta",
    "@factordao/sdk-studio": "pro-beta",
    "@factordao/vault-analytics": "^1.0.34",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "viem": "^1.10.14",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@noble/curves": "^1.9.1",
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.2.2",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@10.28.2+sha512.41872f037ad22f7348e3b1debbaf7e867cfd448f2726d9cf74c08f19507c31d2c8e7a11525b983febc2df640b5438dee6023ebb1f84ed43cc2d654d2bc326264"
}
