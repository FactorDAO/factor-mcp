# Factor MCP Server Configuration

# Alchemy API Key (required for RPC access)
ALCHEMY_API_KEY=your_alchemy_api_key_here

# Default chain (ARBITRUM_ONE, BASE, MAINNET)
DEFAULT_CHAIN=ARBITRUM_ONE

# Simulation mode - when true, returns tx params without broadcasting
SIMULATION_MODE=false

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Custom RPC URL (optional - overrides Alchemy)
# RPC_URL=https://your-custom-rpc.com

# Wallet encryption password (optional - can be set interactively)
# WALLET_PASSWORD=your_secure_password
